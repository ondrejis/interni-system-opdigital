# Vyber klienta: složka v clients/ (při buildu i za běhu). Image se staví per klient.
CLIENT=opsys

# PostgreSQL — aplikace běží pod uživatelem s minimálními právy (bez DDL)
DATABASE_URL=postgres://rebar_app:app@localhost:5434/rebar_dev
# Migrace běží jako samostatný krok pod vlastníkem schématu (pnpm db:migrate), nikdy za běhu aplikace
DATABASE_MIGRATE_URL=postgres://rebar_migrator:migrator@localhost:5434/rebar_dev
DATABASE_APP_ROLE=rebar_app

# Veřejná adresa aplikace (odkazy v e-mailech, kontrola původu požadavků). V produkci musí být https://
APP_URL=http://localhost:3100

# Tajemství, unikátní pro každou instanci (openssl rand -base64 32)
AUTH_SECRET=
# Šifrování tajných nastavení v DB (heslo SMTP…). Přesně 32 bajtů v base64. Rotace: APP_ENCRYPTION_KEYS="2:<nový>,1:<starý>"
APP_ENCRYPTION_KEY=

# Úložiště souborů (mimo veřejnou složku) a stav zálohy zapisovaný zálohovacím skriptem.
# Ve vývoji použijte ABSOLUTNÍ cestu (např. /cesta/k/repu/.data/files): web běží v apps/web a worker/seed v kořeni repa,
# relativní cesta by tak mířila do dvou různých složek (worker pak nenajde nahrané fotky a nevytvoří náhledy).
FILES_DIR=./.data/files
BACKUP_STATUS_FILE=
APP_VERSION=0.0.0-dev

# Token pro GET /api/health (alespoň 16 znaků) a adresa heartbeatu agentury (volitelné)
HEALTH_TOKEN=
HEARTBEAT_URL=

# Push upozornění: OPSYS je nepoužívá (spec nechce žádné notifikace); klíče se nevyplňují
# (platforma zůstává v jádru; vygenerování: pnpm vapid:generate)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Error tracking kompatibilní s GlitchTip (volitelné)
SENTRY_DSN=

# První uživatel (jen pro pnpm db:seed)
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=

# Kontrola uniklých hesel při nastavení hesla (k-anonymní dotaz na api.pwnedpasswords.com, posílá se jen 5 znaků SHA-1).
# `off` ji vypne (offline pravidla pro sílu hesla běží vždy).
# PASSWORD_BREACH_CHECK=off

# Opakované faktury v Můj prostor: `fake` = vestavěný Fakturoid bez sítě (jen lokální vývoj a e2e, v provozu nikdy;
# ostré přístupy se zadávají v Nastavení → Integrace a ukládají se šifrovaně).
# FAKTUROID_MODE=fake

# Lokální vývoj: cluster PostgreSQL pro OPSYS (scripts/dev-db.sh; výchozí port 5434, nikdy 5433)
# REBAR_PG_PORT=5434

# Jen pro automatické testy (http v produkčním režimu). V provozu nikdy.
# APP_ALLOW_HTTP=1
