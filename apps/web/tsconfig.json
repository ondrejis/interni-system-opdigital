{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": false,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@client/config": ["../../clients/_template/config.ts"],
      "@client/extensions": ["../../clients/_template/extensions/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src",
    "e2e",
    "next.config.ts",
    "playwright.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
