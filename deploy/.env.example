# Konfigurace jedné instance (docker compose). Skutečné .env vzniká při instalaci (scripts/install.sh) a nikdy se nedává do gitu.

# --- Klient a verze ---
CLIENT=opsys
APP_IMAGE=ghcr.io/ondrejis/opsys
BACKUP_IMAGE=ghcr.io/ondrejis/stavebni-system-core-backup
APP_TAG=v0.0.0

# --- Adresa a certifikát ---
DOMAIN=system.klient.cz
ACME_EMAIL=info@klient.cz

# --- Tajemství (unikátní pro instanci; vygeneruje install.sh) ---
AUTH_SECRET=
APP_ENCRYPTION_KEY=
# rotace šifrovacího klíče: APP_ENCRYPTION_KEYS="2:<nový>,1:<starý>" (první je aktuální, ostatní jen dešifrují); jinak nechte prázdné
APP_ENCRYPTION_KEYS=
HEALTH_TOKEN=

# --- Databáze ---
DB_NAME=system
DB_SUPERUSER_PASSWORD=
DB_MIGRATOR_USER=system_migrator
DB_MIGRATOR_PASSWORD=
DB_APP_USER=system_app
DB_APP_PASSWORD=

# --- Push upozornění (pnpm vapid:generate; volitelné) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@klient.cz

# --- Monitoring a chyby (volitelné) ---
HEARTBEAT_URL=
SENTRY_DSN=
BESZEL_KEY=
BESZEL_PORT=45876
COMPOSE_PROFILES=

# --- Zálohy (restic do S3 kompatibilního úložiště klienta) ---
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# čas denní zálohy (místní) a den v měsíci pro zkoušku obnovy
BACKUP_TIME=02:30
RESTORE_TEST_DAY=1
