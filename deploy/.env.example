# Konfigurace instance OPSYS (docker compose). Skutečné .env vzniká při instalaci (scripts/install.sh) a nikdy se nedává do gitu.
# Žádná tajná hodnota se do tohoto vzoru nepíše; tajemství integrací (Google OAuth klient, Meta, Fakturoid, INGEST_SECRET
# pro n8n) nejsou v .env, zadávají se v aplikaci (Nastavení) a v databázi jsou šifrovaná klíčem APP_ENCRYPTION_KEY.

# --- Klient a verze ---
CLIENT=opsys
APP_IMAGE=ghcr.io/ondrejis/interni-system-opdigital-opsys
BACKUP_IMAGE=ghcr.io/ondrejis/interni-system-opdigital-backup
APP_TAG=v0.0.0

# --- Adresa a certifikát (veřejná doména s HTTPS; DNS musí mířit na server už při instalaci) ---
DOMAIN=opsys.opdigital.cz
ACME_EMAIL=info@opdigital.cz

# --- OAuth redirecty a adresy pro n8n (jen informace, nic z toho se tu nenastavuje) ---
# Všechny se odvozují z DOMAIN (APP_URL = https://$DOMAIN). Tyto adresy vlož do konzole příslušné služby:
#   Google Cloud Console → OAuth klient (typ Web) → Authorized redirect URI:
#       https://$DOMAIN/api/kalendar/google/callback          (Google Kalendář; klient ID a secret se zadají v Nastavení → Google Kalendář)
#   Google Kalendář push kanály (volá Google, ne prohlížeč; jen přes https):
#       https://$DOMAIN/api/kalendar/google/webhook
#   Meta: bez OAuth přesměrování (dlouhodobý token systémového uživatele se zadá v Nastavení → Integrace → Meta).
#   n8n volá OPSYS (příchozí, podepsané tajemstvím z Nastavení → Integrace):
#       https://$DOMAIN/api/ingest/drive   (callback složek Google Disku)
#       https://$DOMAIN/api/ingest/leads   (leady z Meta)
#   Fakturoid: bez OAuth (přístup se zadá v Nastavení → Integrace), nic v .env.
#   OPSYS volá n8n: adresy webhooků se zadávají v Nastavení → Integrace (ne v .env).

# --- Tajemství (unikátní pro instanci; vygeneruje install.sh) ---
AUTH_SECRET=
APP_ENCRYPTION_KEY=
# rotace šifrovacího klíče: APP_ENCRYPTION_KEYS="2:<nový>,1:<starý>" (první je aktuální, ostatní jen dešifrují); jinak nechte prázdné
APP_ENCRYPTION_KEYS=
HEALTH_TOKEN=

# --- Databáze ---
DB_NAME=system
DB_SUPERUSER_PASSWORD=
DB_MIGRATOR_USER=system_migrator
DB_MIGRATOR_PASSWORD=
DB_APP_USER=system_app
DB_APP_PASSWORD=

# --- Push upozornění: OPSYS je nepoužívá (žádné notifikace), klíče nech prázdné ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Monitoring a chyby (volitelné) ---
HEARTBEAT_URL=
SENTRY_DSN=
BESZEL_KEY=
BESZEL_PORT=45876
COMPOSE_PROFILES=

# --- Zálohy (noční šifrovaný dump a soubory přes restic do S3 kompatibilního úložiště mimo server) ---
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# čas denní zálohy (místní) a den v měsíci pro zkoušku obnovy
BACKUP_TIME=02:30
RESTORE_TEST_DAY=1
